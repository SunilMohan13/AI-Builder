# Required by docker compose. Generate a random value, never reuse one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside development/test the API refuses to start with a missing, default,
# or shorter-than-32-byte secret.
AEROPULSE_JWT_SECRET=
# Optional Live-mode token for the compose web container (mint with the
# command in README; never commit it).
AEROPULSE_WEB_TOKEN=
# local = Parquet + filesystem stores; gcp = BigQuery + Cloud Storage.
AEROPULSE_PLATFORM=local
# Local only: "filesystem" (files under AEROPULSE_DATA_DIR) or "minio" (Compose).
AEROPULSE_LOCAL_OBJECT_STORE=filesystem
AEROPULSE_DATA_DIR=var/aeropulse
# gcp only. Buckets are <prefix>-raw/-citizen/-models/-serving; credentials
# come from Application Default Credentials, never from this file.
AEROPULSE_GCP_PROJECT=
AEROPULSE_GCS_BUCKET=
AEROPULSE_BIGQUERY_DATASET=aeropulse
AEROPULSE_BIGQUERY_MAX_BYTES=1000000000
AEROPULSE_DEFAULT_REGION=in-north
AEROPULSE_CONNECTOR_MODE=replay
# What the map opens on: demo or live. Live also needs AEROPULSE_WEB_TOKEN.
AEROPULSE_UI_MODE=demo
# Google Earth Engine project id. Empty means that source stays not configured.
AEROPULSE_EARTHENGINE_PROJECT=
# Host directory holding application_default_credentials.json, mounted
# read-only into the cycle container. Default: ~/.config/gcloud.
AEROPULSE_GCLOUD_CONFIG_DIR=
# Laptop folder holding the history, trained runs and snapshots that the api,
# cycle and citizen-analyzer containers share. Default: aeropulse-data/ at the
# repository root (git-ignored). Use an absolute path to put it elsewhere.
# On Linux, `sudo chown -R 10001 <folder>` so the container user can write.
AEROPULSE_HOST_DATA_DIR=
# Memory ceiling for the cycle container, which also runs training. Default 4g.
AEROPULSE_CYCLE_MEM_LIMIT=
# Memory ceilings for the API (what-if plumes) and the citizen analyzer
# (photo corroboration). Both read 72 h of history. Default 1g each.
AEROPULSE_API_MEM_LIMIT=
AEROPULSE_CITIZEN_MEM_LIMIT=
# Optional. Development uses a process-local salt when this is empty.
# Set a random value before any non-development environment.
AEROPULSE_CITIZEN_REPORTER_SALT=
# Host ports when talking to the Compose stack from the machine (not from inside a container).
AEROPULSE_DATABASE_URL=postgresql://aeropulse:aeropulse@127.0.0.1:5433/aeropulse
AEROPULSE_REDIS_URL=redis://127.0.0.1:6380/0
AEROPULSE_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
AEROPULSE_LOG_LEVEL=INFO

# --- Live sources (both free to obtain; absence reports NOT_CONFIGURED
# rather than silently replaying a fixture) ---
# https://explore.openaq.org  -> account -> API key
AEROPULSE_OPENAQ_API_KEY=
# https://firms.modaps.eosdis.nasa.gov/api/map_key
AEROPULSE_FIRMS_MAP_KEY=
# If a previous copy of this file contained non-empty keys, rotate them at
# the provider. This example must never ship a credential value.

# --- Copilot ---
# Server-side only. Never expose this to the browser bundle: the frontend
# already ships a JWT there, and a second secret must not follow it.
# Without a key the copilot degrades to deterministic retrieval and says so.
AEROPULSE_GEMINI_API_KEY=
AEROPULSE_GEMINI_MODEL=gemini-3.8-flash

# --- Citizen photos (AI visual observation; uses the same key) ---
# The observer retries transient errors (429, 5xx), then tries each fallback
# model in order (comma-separated). Reports it still cannot observe are
# retried in the background (observer_retry in config/citizen.yaml).
# List the models your key can use: see docs/ops/local-live.md.
AEROPULSE_CITIZEN_VISION_MODEL=gemini-3.8-flash
AEROPULSE_CITIZEN_VISION_FALLBACK_MODELS=
