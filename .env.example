# Copy to .env at the repository root. Never commit secret values.
# Compose reads this file: docker compose --env-file .env -f infrastructure/docker/compose.yaml up --build

# Required. At least 32 bytes. The published development default is rejected.
AEROPULSE_JWT_SECRET=local-only-replace-this-secret-32b

# replay (fixtures, no keys) or live (real upstreams).
AEROPULSE_CONNECTOR_MODE=replay

# Optional live-source credentials. Empty means that source reports not configured.
AEROPULSE_OPENAQ_API_KEY=
AEROPULSE_FIRMS_MAP_KEY=

# Ask AeroPulse. Empty means answers come from stored evidence only.
AEROPULSE_GEMINI_API_KEY=
AEROPULSE_GEMINI_MODEL=gemini-3.8-flash

# Viewer token for the Compose web container. Mint one after the stack can import auth:
#   uv run python -c "from aeropulse_auth import encode_token, Role; print(encode_token('ui', [Role.VIEWER]))"
# Leave empty and Live stays disabled with a reason, instead of sending a rejected token.
AEROPULSE_WEB_TOKEN=

# First map mode in the web container: demo or live.
AEROPULSE_UI_MODE=demo
