# syntax=docker/dockerfile:1
# Static build for Cloud Run (the Compose Dockerfile runs the Vite dev server).
#
#   docker build -f Dockerfile.prod --build-arg VITE_API_BASE=https://<api-url> .
#
# No API token is baked in: a token in a public bundle is a published
# credential. Demo works with no API; Live reports "not configured" until
# sign-in exists (OIDC is later, per AGENTS.md).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE \
    VITE_DEFAULT_DATA_MODE=demo
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
