# Secrets. Never commit real keys, tokens, or local env files.
.env
**/.env
*.local
infrastructure/docker/env.txt

# Terraform working files and local state
.terraform/
*.tfstate
*.tfstate.backup

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node and frontend build output
node_modules/
frontend/web/dist/
frontend/web/.netlify/
# Copied from node_modules at Vite build start.
frontend/web/public/maplibre-gl-*.mjs

# Tool output and editor state
.remember/
.DS_Store
.vscode/
var/

# Notebook autosaves
**/.ipynb_checkpoints/

# Loaded history, trained runs and snapshots, and their archives
# (scripts/history.py). Gigabytes, and not reviewable.
/aeropulse-data/
/aeropulse-data.before-restore-*/
/aeropulse-backups/

# Generated training artifacts. Rebuild with `uv run aeropulse-ml train`.
data/training/
models/*.joblib
