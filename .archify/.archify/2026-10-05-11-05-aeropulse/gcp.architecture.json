  "cards": [
    {
      "dot": "cyan",
      "title": "Deploy order",
      "items": [
        "Build images with the gcp extra, then apply Terraform.",
        "Add secret versions out of band. State holds names only.",
        "The web image is built with the API URL and no token."
      ]
    },
    {
      "dot": "rose",
      "title": "Who can call what",
      "items": [
        "Web and API allow public invoke. The analyzer does not.",
        "Only sa-push and sa-api can invoke the analyzer.",
        "Signed upload URLs use IAM signBlob, not a key file."
      ]
    },
    {
      "dot": "amber",
      "title": "Not in this stack yet",
      "items": [
        "Nothing publishes aero.alerts. Alerts are rows in ops.alerts.",
        "The cycle job is not marked production, so it does not need a JWT secret.",
        "Terraform is validated. It has not been applied."
      ]
    }
