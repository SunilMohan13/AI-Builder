  "cards": [
    {
      "dot": "emerald",
      "title": "The model cannot open an event",
      "items": [
        "Gemini returns a schema-bound visual class and no figures.",
        "The observation is labelled requires corroboration.",
        "Only the deterministic check can attach the report to existing evidence."
      ]
    },
    {
      "dot": "rose",
      "title": "Bad photos stop early",
      "items": [
        "Sanitize rejects oversize, disallowed types, and failed geo checks.",
        "A rejected image is stored for operators and does not seed a watch.",
        "An untrusted location never seeds a plume origin, even if accepted."
      ]
    },
    {
      "dot": "amber",
      "title": "Who may call the analyzer",
      "items": [
        "Push uses an OIDC token as sa-push. Delivery fails to the DLQ after 5 tries.",
        "The API sends its Google identity beside the operator JWT.",
        "Missing Google credentials surface as analyzer unavailable, not a crash."
      ]
    }
  ]
