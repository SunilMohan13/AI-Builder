  "cards": [
    {
      "dot": "emerald",
      "title": "Live never paints Demo",
      "items": [
        "Demo answers from a committed recording of the real API.",
        "A failed Live call is shown and thrown. It does not read that recording."
      ]
    },
    {
      "dot": "cyan",
      "title": "What one cycle writes",
      "items": [
        "Features, four families, plumes, and the incident graph run inside the cycle.",
        "The versioned snapshot is written before latest.json moves.",
        "Replay uses its own prefix and never moves the live pointer."
      ]
    },
    {
      "dot": "rose",
      "title": "Numbers stay honest",
      "items": [
        "No language model runs on detection, forecast, hazard, anomaly, plume, or events.",
        "Ask AeroPulse may only repeat figures its tools returned, after grounding.",
        "A missing Gemini key leaves deterministic answers in place."
      ]
    },
    {
      "dot": "amber",
      "title": "Until a model is promoted",
      "items": [
        "Each family is a degraded rule with a reason, a version, and provenance.",
        "Hazard 0.80 is a rank until the gate report marks that region calibrated."
      ]
    }
