    {
      "dot": "cyan",
      "title": "Command",
      "items": [
        "uv run aeropulse-ml train --family all --dataset fixture --regions in-north",
        "BigQuery: --dataset bq://PROJECT/aeropulse --regions in-north,sg-singapore",
        "The training image entrypoint is aeropulse-ml train. A run never promotes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Gates, not lowered",
      "items": [
        "Forecast: RMSE skill > 0 vs persistence, CAMS, and climatology; coverage >= 0.70.",
        "Hazard: PR-AUC margin >= 0.05; quiet-hour false alerts <= 0.10.",
        "Anomaly: F1 >= 0.30 and above the absolute-threshold rule. At least 3 folds."
      ]
    },
    {
      "dot": "rose",
      "title": "Training never edits serving",
      "items": [
        "Copy the printed snippet into config/model_serving.yaml. CI runs serving --strict.",
        "Source likelihood has no gold labels, so it is never a served model.",
        "Resolver refusal, a missing file, or a hash mismatch keeps the rule."
      ]
    }
