# Copy to .env in this folder, or rely on a parent AeroPulse_ML_Notebooks/.env
# find_dotenv(usecwd=True) walks upward, so a parent .env is enough to start.

AEROPULSE_PROJECT_ROOT=.
PM25_DATA_ROOT=../pm25_estimator

# Horizons (hours) to model. Each gets its own residual model, its own
# baseline anchor, and its own promotion decision.
PROP_HORIZONS=1,3,6,12,24,48

# Chronological split. The remainder after train+valid is the sealed test
# period, which nothing before notebook 07 is allowed to read.
PROP_TRAIN_FRACTION=0.70
PROP_VALID_FRACTION=0.15

# Compute budget. Blank = use every training row (~1.1M). Set a number to cap
# training rows via even thinning across time (not a random draw), which is
# what keeps notebooks 05-07 to minutes rather than hours.
PROP_MAX_TRAIN_ROWS=

# Rolling-origin folds (notebook 07) and geographic blocks for the holdout.
PROP_ROLLING_FOLDS=4
PROP_GEO_BLOCKS=5

# Random-search budget for hyperparameter tuning (notebook 05).
PROP_TUNING_TRIALS=20
