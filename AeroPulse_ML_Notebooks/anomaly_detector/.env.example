# Copy to .env in this folder, or rely on a parent AeroPulse_ML_Notebooks/.env
# find_dotenv(usecwd=True) walks upward, so a parent .env is enough to start.

# Paths (relative to this folder when you launch Jupyter from here)
AEROPULSE_PROJECT_ROOT=.
PM25_DATA_ROOT=../pm25_estimator

# Detection operating point
# CPCB NAQI "Very Poor" breakpoint — the external label, not a residual-derived proxy.
ANOMALY_VERY_POOR_UGM3=121
# Maximum allowed false-alert rate when choosing the residual-margin threshold.
ANOMALY_FALSE_ALERT_BUDGET=0.05

# Optional: only needed if you later re-fetch data. Not used by the import pipeline.
# OPENAQ_API_KEY=
# FIRMS_MAP_KEY=
