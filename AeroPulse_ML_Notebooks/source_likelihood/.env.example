# Copy to .env in this folder, or rely on a parent AeroPulse_ML_Notebooks/.env
# find_dotenv(usecwd=True) walks upward, so a parent .env is enough to start.

AEROPULSE_PROJECT_ROOT=.
PM25_DATA_ROOT=../pm25_estimator

# Chronological split. The remainder after train+valid is the sealed test
# period, which nothing before notebook 06 is allowed to score against.
SOURCE_TRAIN_FRACTION=0.70
SOURCE_VALID_FRACTION=0.15

# Compute budget. Blank = use every training row (~1.2M). Set a number to cap
# training rows by even thinning across time; this is the dial for 05-08.
SOURCE_MAX_TRAIN_ROWS=

# k-means geographic blocks for the spatial holdout (notebook 07).
SOURCE_GEO_BLOCKS=5

# Events sampled into the human-review annotation sheet (notebook 08).
SOURCE_GOLD_SET_SIZE=300

# Legacy OpenAQ co-pollutant fetch. No longer needed: the upstream table
# carries CAMS NO2/CO/SO2/O3/PM10 at full coverage. Kept so an existing .env
# does not break, but enabling it changes nothing in the pipeline.
SOURCE_ENABLE_COPOLLUTANTS=0

# OPENAQ_API_KEY=
